<% content_for :title, "Upload Migration" %>
<% content_for :header, "Upload Migration" %>

<div>
  <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <p class="mt-1 text-sm text-gray-500">
      Upload a CSV file to begin a new data migration.
    </p>

    <%= form_with url: migrations_path, multipart: true, class: "mt-6", data: { turbo: false } do |form| %>
      <div>
        <%= form.label :csv_file, "CSV File", class: "block text-sm font-medium text-gray-700" %>

        <%= form.file_field :csv_file, accept: ".csv,text/csv", 
                class: "mt-2 block w-full rounded-lg border border-gray-300 bg-white text-sm text-gray-700
                    file:mr-4 file:border-0 file:bg-gray-100 file:px-4 file:py-2
                    file:text-sm file:font-medium file:text-gray-700
                    hover:file:bg-gray-200
                    focus:outline-none focus:ring-2 focus:ring-blue-500" 
        %>
      </div>

      <div class="mt-6 flex justify-end">
        <%= form.submit "Upload", class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
      </div>
    <% end %>
  </div>
</div>

