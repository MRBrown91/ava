<% content_for :title, "Migration" %>
<% content_for :header, "Migration" %>

<div class="space-y-6">

  <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="mb-4 text-lg font-semibold text-gray-900">General</h2>

    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-gray-500">ID</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.id %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Status</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.status %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Source Type</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.source_type %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Started At</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.started_at || "-" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Completed At</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.completed_at || "-" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Total Time</dt>
        <dd class="mt-1 text-sm text-gray-900">
          <% if @data_migration.started_at.present? && @data_migration.completed_at.present? %>
            <%= distance_of_time_in_words(@data_migration.started_at, @data_migration.completed_at) %>
          <% else %>
            -
          <% end %>
        </dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Rows Processed</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.rows_processed || "-" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Rows Inserted</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.rows_inserted || "-" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Rows Updated</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.rows_updated || "-" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Rows Skipped</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.rows_skipped || "-" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Rows Failed</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.rows_failed || "-" %></dd>
      </div>
    </dl>
  </section>

  <% if @data_migration.source_type == "csv_upload" %>
    <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="mb-4 text-lg font-semibold text-gray-900">CSV Upload</h2>

      <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-gray-500">Filename</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <%= @data_migration.source&.filename || "-" %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">IP Addres</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <%= @data_migration.source&.ip_address || "-" %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">User Agent</dt>
          <dd class="mt-1 text-sm text-gray-900">
            <%= @data_migration.source&.user_agent || "-" %>
          </dd>
        </div>
      </dl>
    </section>
  <% end %>

  <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="mb-4 text-lg font-semibold text-gray-900">Extraction</h2>

    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-gray-500">Started At</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.extract_started_at || "-" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Completed At</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.extract_completed_at || "-" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Time</dt>
        <dd class="mt-1 text-sm text-gray-900">
          <%= @data_migration.extract_time_ms.present? ? "#{@data_migration.extract_time_ms} ms" : "-" %>
        </dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Rows Extracted</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.rows_extracted || "-" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Extracted Size</dt>
        <dd class="mt-1 text-sm text-gray-900">
          <%= @data_migration.extracted_size_bytes.present? ? number_to_human_size(@data_migration.extracted_size_bytes) : "-" %>
        </dd>
      </div>
    </dl>
  </section>

  <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="mb-4 text-lg font-semibold text-gray-900">Transformation</h2>

    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-gray-500">Started At</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.transform_started_at || "-" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Completed At</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.transform_completed_at || "-" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Time</dt>
        <dd class="mt-1 text-sm text-gray-900">
          <%= @data_migration.transform_time_ms.present? ? "#{@data_migration.transform_time_ms} ms" : "-" %>
        </dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Rows Transformed</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.rows_transformed || "-" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Rows Skipped</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.rows_skipped_at_transform || "-" %></dd>
      </div>
    </dl>
  </section>

  <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="mb-4 text-lg font-semibold text-gray-900">Load</h2>

    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-gray-500">Started At</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.load_started_at || "-" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Completed At</dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @data_migration.load_completed_at || "-" %></dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">Time</dt>
        <dd class="mt-1 text-sm text-gray-900">
          <%= @data_migration.load_time_ms.present? ? "#{@data_migration.load_time_ms} ms" : "-" %>
        </dd>
      </div>
    </dl>
  </section>

  <section class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="mb-4 text-lg font-semibold text-gray-900">Errors</h2>

    <% if @migration_errors.any? %>
      <ul class="space-y-3">
        <% @migration_errors.each do |error| %>
          <li class="rounded-md border border-gray-200 p-3 text-sm">
            <div>
              <strong class="font-semibold text-gray-900"><%= error.severity %></strong>
              <span class="text-gray-500">[<%= error.stage %>]</span>
            </div>

            <div class="mt-1 text-gray-700">
              <%= error.message %>
            </div>

            <div class="mt-1 text-xs text-gray-500">
              <%= error.created_at %>
            </div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-gray-500">No errors.</p>
    <% end %>
  </section>

</div>