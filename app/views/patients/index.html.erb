<% content_for :title, "Patients" %>
<% content_for :header, "Patients" %>

<table class="min-w-full divide-y divide-gray-200">
  <thead>
    <tr class="text-left">
      <th>ID</th>
      <th>Health ID</th>
      <th>Health ID Province</th>
      <th>First Name</th>
      <th>Middle Name</th>
      <th>Last Name</th>
      <th>Phone</th>
      <th>Email</th>
      <th>Date of Birth</th>
      <th>Sex</th>
      <th>Address</th>
      <th>City</th>
      <th>Address Province</th>
      <th>Postal Code</th>
    </tr>
  </thead>
  <tbody>
    <% @patients.each do |patient| %>
      <tr>
        <td><%= patient.id %></td>
        <td><%= patient.patient_health_identifier_number %></td>
        <td><%= patient.patient_health_identifier_number_province %></td>
        <td><%= patient.first_name %></td>
        <td><%= patient.middle_name.presence || '-' %></td>
        <td><%= patient.last_name %></td>
        <td><%= patient.phone.presence || '-' %></td>
        <td><%= patient.email.presence || '-' %></td>
        <td><%= patient.dob.present? ? patient.dob.strftime("%-m/%-d/%Y") : '-' %></td>
        <td><%= patient.sex.presence || '-' %></td>
        <td><%= patient.address&.address_line_1.presence || '-' %></td>
        <td><%= patient.address&.city.presence || '-' %></td>
        <td><%= patient.address&.province.presence || '-' %></td>
        <td><%= patient.address&.postal_code.presence || '-' %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @pagy.pages > 1 %>
  <div class="flex justify-center my-6">
    <%== @pagy.series_nav %>
  </div>
<% end %>
